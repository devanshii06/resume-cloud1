# Copy this file to ".env" and fill in the values. NEVER upload .env to GitHub.

# 1 = run on your laptop with SQLite + a local folder (no AWS needed)
# 0 = production mode (uses RDS + S3)
USE_LOCAL=1

SECRET_KEY=change-this-to-a-long-random-string

# ---- Only needed when USE_LOCAL=0 (on EC2) ----
AWS_REGION=ap-south-1
S3_BUCKET=your-unique-bucket-name
DB_HOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=resumedb
DB_USER=admin
DB_PASSWORD=your-rds-password
